@page
@model IndexModel
@{
    ViewData["Title"] = "3D Dual-Camera Drone Triangulation";
}

<style>
    :root {
        --bg-dark: #0A0F1D;
        --bg-card: #151D2A;
        --accent-blue: #38BDF8;
        --accent-green: #4ADE80;
        --accent-amber: #FBBF24;
        --accent-red: #F87171;
        --accent-cyan: #06B6D4;
        --text-primary: #F1F5F9;
        --text-secondary: #94A3B8;
        --text-dim: #64748B;
        --border: #26334D;
    }
    body { background: var(--bg-dark) !important; color: var(--text-primary); font-family: 'Segoe UI', system-ui, sans-serif; }
    .page-wrapper { max-width: 1500px; margin: 0 auto; padding: 16px 16px 36px 16px; }
    .page-title {
        text-align: center; font-size: 1.6rem; font-weight: 800;
        background: linear-gradient(135deg, var(--accent-cyan), var(--accent-blue));
        -webkit-background-clip: text; -webkit-text-fill-color: transparent;
        margin-bottom: 4px; letter-spacing: -0.5px;
    }
    .page-subtitle { text-align: center; color: var(--text-dim); font-size: 0.82rem; margin-bottom: 16px; }

    /* Config Panel */
    .ctrl-panel {
        background: var(--bg-card); border: 1px solid var(--border); border-radius: 12px;
        padding: 14px 20px; margin-bottom: 14px; display: flex; gap: 24px; flex-wrap: wrap; align-items: center;
    }
    .ctrl-panel label { color: var(--text-secondary); font-size: 0.8rem; font-weight: 600; }
    .ctrl-val { color: var(--accent-cyan); font-weight: 800; font-size: 1rem; }
    .ctrl-group { flex: 1; min-width: 170px; }
    .ctrl-panel input[type=range] { width: 100%; accent-color: var(--accent-cyan); margin-top: 4px; }
    .ctrl-panel input[type=number] {
        background: var(--bg-dark); color: var(--accent-cyan); border: 1px solid var(--border);
        border-radius: 6px; padding: 4px 8px; width: 100%; font-weight: 700; font-size: 0.9rem;
    }

    /* Main Layout — Viewport + Side Panel */
    .main-row { display: flex; gap: 14px; flex-wrap: wrap; }

    /* 3D Viewport Card */
    .viewport-card {
        flex: 3; min-width: 500px; background: var(--bg-card); border: 1px solid var(--border);
        border-radius: 12px; overflow: hidden; position: relative;
    }
    .card-hdr {
        padding: 10px 16px; font-weight: 700; font-size: 0.85rem;
        background: linear-gradient(135deg, #1E3A8A, #1D4ED8); color: white;
    }
    #threeCanvasContainer { width: 100%; height: 560px; position: relative; cursor: crosshair; }

    /* View Preset Buttons inside Viewport */
    .view-bar {
        position: absolute; top: 12px; left: 12px; z-index: 10;
        display: flex; gap: 6px;
    }
    .view-btn {
        padding: 5px 10px; border: 1px solid rgba(255,255,255,0.15); background: rgba(15,23,42,0.8);
        color: #CBD5E1; border-radius: 6px; cursor: pointer; font-size: 0.72rem; font-weight: 700;
        transition: all 0.2s; backdrop-filter: blur(4px);
    }
    .view-btn:hover, .view-btn.active { background: var(--accent-blue); color: #0F172A; border-color: var(--accent-blue); }

    /* Side Panel */
    .side-panel {
        flex: 1; min-width: 300px; display: flex; flex-direction: column; gap: 14px;
    }
    .side-card {
        background: var(--bg-card); border: 1px solid var(--border); border-radius: 12px; overflow: hidden;
    }
    .side-hdr {
        padding: 10px 16px; font-weight: 700; font-size: 0.85rem;
    }
    .side-hdr.green { background: linear-gradient(135deg, #065F46, #059669); color: white; }
    .side-hdr.amber { background: linear-gradient(135deg, #78350F, #D97706); color: white; }

    /* Input Rows */
    .input-row {
        padding: 10px 16px; display: flex; gap: 8px; align-items: flex-end; flex-wrap: wrap;
        border-bottom: 1px solid var(--border);
    }
    .input-cell { flex: 1; min-width: 60px; }
    .input-cell label { display: block; color: var(--text-dim); font-size: 0.68rem; font-weight: 600; margin-bottom: 3px; }
    .input-cell input[type=number] {
        background: var(--bg-dark); border: 1px solid var(--border); border-radius: 6px;
        padding: 5px 8px; width: 100%; font-weight: 700; font-size: 0.85rem;
    }
    .inp-blue { color: var(--accent-blue); }
    .inp-green { color: var(--accent-green); }
    .inp-amber { color: var(--accent-amber); }
    .btn-apply {
        padding: 6px 14px; border: none; border-radius: 6px; font-weight: 700;
        font-size: 0.78rem; cursor: pointer; transition: all 0.2s; align-self: flex-end;
    }
    .btn-apply.blue { background: var(--accent-blue); color: #0F172A; }
    .btn-apply.blue:hover { background: #0284C7; box-shadow: 0 0 12px rgba(56,189,248,0.4); }
    .btn-apply.amber { background: var(--accent-amber); color: #0F172A; }
    .btn-apply.amber:hover { background: #D97706; box-shadow: 0 0 12px rgba(251,191,36,0.4); }

    /* Info Rows */
    .info-row {
        padding: 10px 16px; display: grid; grid-template-columns: 1fr 1fr; gap: 6px 16px;
        font-size: 0.82rem; color: var(--text-secondary);
        background: rgba(10, 15, 29, 0.4);
    }
    .info-row b { color: var(--text-primary); }
    .val-blue { color: var(--accent-blue) !important; font-weight: 800; }
    .val-green { color: var(--accent-green) !important; font-weight: 800; }
    .val-cyan { color: var(--accent-cyan) !important; font-weight: 800; }
    .val-amber { color: var(--accent-amber) !important; font-weight: 800; }

    /* Proof Badge */
    .proof-badge { display: inline-block; padding: 3px 10px; border-radius: 20px; font-weight: 800; font-size: 0.75rem; }
    .proof-ok { background: rgba(74,222,128,0.15); color: var(--accent-green); border: 1px solid rgba(74,222,128,0.3); }
    .proof-err { background: rgba(248,113,113,0.15); color: var(--accent-red); border: 1px solid rgba(248,113,113,0.3); }
</style>

<div class="page-wrapper">
    <div class="page-title">🧊 3D Dual-Camera Drone Triangulation Proof System</div>
    <div class="page-subtitle">คลิกลากจุดโดรนสีฟ้าในพื้นที่ 3D • หมุนมุมมองด้วยเมาส์ • กดปุ่ม View เพื่อสลับมุมมอง CAD</div>

    <!-- Config Panel -->
    <div class="ctrl-panel">
        <!-- Row 1: Optics & Baseline -->
        <div style="display: flex; gap: 16px; align-items: center; width: 100%; flex-wrap: wrap; border-bottom: 1px solid var(--border); padding-bottom: 10px;">
            <div class="ctrl-group" style="min-width: 150px;">
                <label>📷 Camera / Lens</label>
                <select id="selLens" class="ctrl-select" onchange="onLensChange()" style="background:var(--bg-dark); color:var(--accent-cyan); border:1px solid var(--border); border-radius:6px; padding:5px 8px; width:100%; font-weight:700; font-size:0.82rem; margin-top:4px;">
                    <option value="elp12" selected>ELP 12.0 mm (720p 60fps • 2860 px)</option>
                    <option value="elp28">ELP 2.8 mm Wide (720p • 667 px)</option>
                    <option value="elp50">ELP 50.0 mm Tele (720p • 11918 px)</option>
                    <option value="demo">CAD Demo Scale (100.5 unit)</option>
                    <option value="custom">Custom mm value...</option>
                </select>
            </div>
            <div class="ctrl-group">
                <label>📏 Baseline (B) = <span class="ctrl-val" id="lblB">20.0</span> m</label>
                <input type="range" id="sldrB" min="5" max="60" step="0.5" value="20" oninput="onCfg()">
            </div>
            <div class="ctrl-group">
                <label>🎯 Convergence (R) = <span class="ctrl-val" id="lblR">100</span> m</label>
                <input type="range" id="sldrR" min="30" max="250" step="1" value="100" oninput="onCfg()">
            </div>
            <div class="ctrl-group" style="min-width: 160px;">
                <label>🔭 Focal Length (f) = <span class="ctrl-val" id="lblF">12.0 mm</span> <span id="lblFPx" style="font-size:0.75rem; color:var(--text-dim);">(≈ 2860 px / 720p)</span></label>
                <input type="number" id="inpF" value="12.0" step="0.5" onchange="onCustomFmm()">
            </div>
        </div>
        <!-- Row 2: Camera Heights & Focus Heights -->
        <div style="display: flex; gap: 16px; align-items: center; width: 100%; flex-wrap: wrap; padding-top: 4px;">
            <div class="ctrl-group" style="flex: 1; min-width: 120px;">
                <label style="color: #F87171;">📸 Cam 1 Height (H1)</label>
                <div style="display:flex; align-items:center; gap:6px; margin-top:3px;">
                    <input type="number" id="inpCam1H" value="0.0" step="0.5" oninput="onCfg()" style="background:var(--bg-dark); color:#F87171; border:1px solid rgba(248,113,113,0.4); border-radius:6px; padding:4px 8px; width:100%; font-weight:700; font-size:0.85rem;">
                    <span style="font-size:0.75rem; color:var(--text-dim);">m</span>
                </div>
            </div>
            <div class="ctrl-group" style="flex: 1; min-width: 120px;">
                <label style="color: #FB923C;">📸 Cam 2 Height (H2)</label>
                <div style="display:flex; align-items:center; gap:6px; margin-top:3px;">
                    <input type="number" id="inpCam2H" value="0.0" step="0.5" oninput="onCfg()" style="background:var(--bg-dark); color:#FB923C; border:1px solid rgba(251,146,60,0.4); border-radius:6px; padding:4px 8px; width:100%; font-weight:700; font-size:0.85rem;">
                    <span style="font-size:0.75rem; color:var(--text-dim);">m</span>
                </div>
            </div>
            <div class="ctrl-group" style="flex: 1; min-width: 130px;">
                <label style="color: #4ADE80;">🎯 Focus Height Cam 1</label>
                <div style="display:flex; align-items:center; gap:6px; margin-top:3px;">
                    <input type="number" id="inpConv1H" value="0.0" step="0.5" oninput="onCfg()" style="background:var(--bg-dark); color:#4ADE80; border:1px solid rgba(74,222,128,0.4); border-radius:6px; padding:4px 8px; width:100%; font-weight:700; font-size:0.85rem;">
                    <span style="font-size:0.75rem; color:var(--text-dim);">m</span>
                </div>
            </div>
            <div class="ctrl-group" style="flex: 1; min-width: 130px;">
                <label style="color: #22D3EE;">🎯 Focus Height Cam 2</label>
                <div style="display:flex; align-items:center; gap:6px; margin-top:3px;">
                    <input type="number" id="inpConv2H" value="0.0" step="0.5" oninput="onCfg()" style="background:var(--bg-dark); color:#22D3EE; border:1px solid rgba(34,211,238,0.4); border-radius:6px; padding:4px 8px; width:100%; font-weight:700; font-size:0.85rem;">
                    <span style="font-size:0.75rem; color:var(--text-dim);">m</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Row: Viewport + Side Panel -->
    <div class="main-row">

        <!-- 3D Viewport -->
        <div class="viewport-card">
            <div class="card-hdr">🧊 SolidWorks 3D Viewport — คลิกซ้ายลากบนพื้น • คลิกขวาลากขึ้น-ลง</div>
            <div id="threeCanvasContainer">
                <div class="view-bar">
                    <button class="view-btn active" id="btnTop" onclick="setView('top')">Top View</button>
                    <button class="view-btn" id="btnSide" onclick="setView('side')">Side View</button>
                    <button class="view-btn" id="btnIso" onclick="setView('iso')">Isometric</button>
                    <span style="border-left: 1px solid rgba(255,255,255,0.2); margin: 0 4px; height: 18px; align-self: center;"></span>
                    <button class="view-btn active" id="btnToggleLabels" onclick="toggleLabels()">🏷️ 3D Labels: ON</button>
                    <button class="view-btn active" id="btnToggleScreens" onclick="toggleScreens()">📺 FOV Screens: ON</button>
                    <button class="view-btn active" id="btnToggleRays" onclick="toggleRays()">⚡ Laser Rays: ON</button>
                </div>
            </div>
            <!-- Viewport Info Row -->
            <div class="info-row" style="border-top: 1px solid var(--border);">
                <div><b>พิกัดโดรน (X, Y, Z):</b> <span class="val-blue" id="oPos">-</span></div>
                <div><b>Distance 3D:</b> <span class="val-cyan" id="oDist">-</span></div>
                <div><b>d1y (กล้อง 1):</b> <span class="val-amber" id="oD1Z">-</span></div>
                <div><b>d2y (กล้อง 2):</b> <span class="val-amber" id="oD2Z">-</span></div>
                <div><b>dz (ความสูง):</b> <span class="val-amber" id="oDY">-</span></div>
                <div><b>มุมมองปัจจุบัน:</b> <span class="val-cyan" id="oView">Top View</span></div>
            </div>
        </div>

        <!-- Side Panel -->
        <div class="side-panel">

            <!-- Input: Drone Position (X, Y, Z) -->
            <div class="side-card">
                <div class="side-hdr green">📍 กำหนดพิกัดโดรน 3D (X, Y, Z)</div>
                <div class="input-row">
                    <div class="input-cell">
                        <label>X (พุ่งหน้า)</label>
                        <input type="number" id="inpX" class="inp-blue" value="80" step="1">
                    </div>
                    <div class="input-cell">
                        <label>Y (ซ้าย-ขวา)</label>
                        <input type="number" id="inpY" class="inp-blue" value="10" step="1">
                    </div>
                    <div class="input-cell">
                        <label>Z (ความสูง)</label>
                        <input type="number" id="inpZ" class="inp-blue" value="15" step="1">
                    </div>
                    <button class="btn-apply blue" onclick="applyXYZ()">✓ Apply</button>
                </div>
            </div>

            <!-- Input: Image Offsets (d1y, d2y, dz1, dz2) -->
            <div class="side-card">
                <div class="side-hdr amber">📐 กำหนดค่าเบี่ยงเบนภาพ <span id="hdrOffsetUnit" style="font-size:0.75rem; opacity:0.85;">(px)</span></div>
                <div class="input-row">
                    <div class="input-cell">
                        <label>d1y (px)</label>
                        <input type="number" id="inpD1Z" class="inp-amber" value="0" step="1">
                    </div>
                    <div class="input-cell">
                        <label>d2y (px)</label>
                        <input type="number" id="inpD2Z" class="inp-amber" value="0" step="1">
                    </div>
                    <div class="input-cell">
                        <label>dz1 (กล้อง 1)</label>
                        <input type="number" id="inpDY" class="inp-amber" value="0" step="1">
                    </div>
                    <div class="input-cell">
                        <label>dz2 (กล้อง 2)</label>
                        <input type="number" id="inpDY2" class="inp-amber" value="0" step="1">
                    </div>
                    <button class="btn-apply amber" onclick="applyReverse()">✓ Apply</button>
                </div>
            </div>

            <!-- Proof Results -->
            <div class="side-card">
                <div class="side-hdr" style="background: linear-gradient(135deg, #1E3A5F, #0E7490); color: white;">
                    📊 ผลการพิสูจน์สูตร 3D (Proof)
                </div>
                <div class="info-row">
                    <div><b>พิกัดถอดสูตร:</b> <span class="val-green" id="oCalc">-</span></div>
                    <div><b>สถานะ:</b> <span id="oProof" class="proof-badge proof-ok">-</span></div>
                    <div><b>β1 กล้อง 1:</b> <span class="val-cyan" id="oB1">-</span>°</div>
                    <div><b>β2 กล้อง 2:</b> <span class="val-cyan" id="oB2">-</span>°</div>
                    <div><b>Δβ มุมตัด:</b> <span class="val-amber" id="oDB">-</span>°</div>
                    <div><b>Error:</b> <span class="val-green" id="oErr">-</span></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Three.js CDN, OrbitControls, CSS2DRenderer -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/renderers/CSS2DRenderer.js"></script>

<style>
    /* 3D Label Styles */
    .label3d {
        font-family: 'Segoe UI', system-ui, sans-serif;
        font-size: 11px; font-weight: 700;
        padding: 2px 7px; border-radius: 4px;
        pointer-events: none; white-space: nowrap;
        text-shadow: 0 1px 3px rgba(0,0,0,0.8);
    }
    .label3d.cam1 { color: #F87171; background: rgba(248,113,113,0.15); border: 1px solid rgba(248,113,113,0.3); }
    .label3d.cam2 { color: #FB923C; background: rgba(251,146,60,0.15); border: 1px solid rgba(251,146,60,0.3); }
    .label3d.drone { color: #38BDF8; background: rgba(56,189,248,0.15); border: 1px solid rgba(56,189,248,0.3); font-size: 12px; }
    .label3d.conv { color: #EF4444; background: rgba(239,68,68,0.12); border: 1px solid rgba(239,68,68,0.25); font-size: 10px; }
    .label3d.dist { color: #4ADE80; background: rgba(74,222,128,0.12); border: 1px solid rgba(74,222,128,0.2); font-size: 10px; }
    .label3d.dist2 { color: #22D3EE; background: rgba(34,211,238,0.12); border: 1px solid rgba(34,211,238,0.2); font-size: 10px; }
    .label3d.conv-dist { color: #94A3B8; background: rgba(148,163,184,0.1); border: 1px solid rgba(148,163,184,0.15); font-size: 10px; }
    .label3d.alt { color: #38BDF8; background: rgba(56,189,248,0.1); border: 1px solid rgba(56,189,248,0.15); font-size: 10px; }
    .label3d.baseline { color: #38BDF8; background: rgba(15,23,42,0.85); border: 1px solid rgba(56,189,248,0.4); font-size: 10px; }
    .label3d.fov1-dot { color: #F87171; background: rgba(15,23,42,0.9); border: 1px solid #F87171; font-size: 11px; box-shadow: 0 0 8px rgba(248,113,113,0.4); }
    .label3d.fov2-dot { color: #FB923C; background: rgba(15,23,42,0.9); border: 1px solid #FB923C; font-size: 11px; box-shadow: 0 0 8px rgba(251,146,60,0.4); }
    .label3d.screen-tag1 { color: #F87171; background: rgba(15,23,42,0.85); border: 1px solid rgba(248,113,113,0.4); font-size: 9px; opacity: 0.9; }
    .label3d.screen-tag2 { color: #FB923C; background: rgba(15,23,42,0.85); border: 1px solid rgba(251,146,60,0.4); font-size: 9px; opacity: 0.9; }
</style>

<script>
// ====== Config & State ======
let dronePos = new THREE.Vector3(80, 15, 10);
let isDragging = false;
let currentView = 'top';

// ====== Three.js Setup ======
const container = document.getElementById('threeCanvasContainer');
const scene = new THREE.Scene();
scene.background = new THREE.Color(0x0A0F1D);
scene.fog = new THREE.FogExp2(0x0A0F1D, 0.003);

const camera = new THREE.PerspectiveCamera(45, container.clientWidth / container.clientHeight, 0.1, 1200);
const renderer = new THREE.WebGLRenderer({ antialias: true });
renderer.setSize(container.clientWidth, container.clientHeight);
renderer.setPixelRatio(window.devicePixelRatio);
container.appendChild(renderer.domElement);

// CSS2D Label Renderer (overlays HTML labels on 3D scene)
const labelRenderer = new THREE.CSS2DRenderer();
labelRenderer.setSize(container.clientWidth, container.clientHeight);
labelRenderer.domElement.style.position = 'absolute';
labelRenderer.domElement.style.top = '0';
labelRenderer.domElement.style.pointerEvents = 'none';
container.appendChild(labelRenderer.domElement);

const controls = new THREE.OrbitControls(camera, renderer.domElement);
controls.enableDamping = true; controls.dampingFactor = 0.08;

// ====== CAD Scene Objects ======
// Grid Floor (XZ Ground Plane)
const gridMajor = new THREE.GridHelper(400, 20, 0x1E3A5F, 0x0F1D2E);
const gridMinor = new THREE.GridHelper(400, 80, 0x162538, 0x0F1D2E);
scene.add(gridMajor); scene.add(gridMinor);

// 3D Axis Helper
const axes = new THREE.AxesHelper(40);
scene.add(axes);

// Symmetric Baseline Axis (Negative Z-axis towards Cam 2, matching blue axis)
const negZMat = new THREE.LineBasicMaterial({ color: 0x0000ff });
const negZGeo = new THREE.BufferGeometry();
const negZLine = new THREE.Line(negZGeo, negZMat);
scene.add(negZLine);

// Positive Z Extension (if baseline exceeds 40m, ensures symmetry)
const posZExtGeo = new THREE.BufferGeometry();
const posZExtLine = new THREE.Line(posZExtGeo, negZMat);
scene.add(posZExtLine);

// Dedicated Baseline Connection Line (between Cam 2 and Cam 1)
const baselineMat = new THREE.LineBasicMaterial({ color: 0x38BDF8, linewidth: 2 });
const baselineGeo = new THREE.BufferGeometry();
const baselineLine = new THREE.Line(baselineGeo, baselineMat);
scene.add(baselineLine);

// Ground Baseline Line (on floor Y=0 between (0, 0, -hb) and (0, 0, hb))
const groundBaselineMat = new THREE.LineDashedMaterial({ color: 0x0284C7, dashSize: 1.5, gapSize: 1.0, transparent: true, opacity: 0.8 });
const groundBaselineGeo = new THREE.BufferGeometry();
const groundBaselineLine = new THREE.Line(groundBaselineGeo, groundBaselineMat);
scene.add(groundBaselineLine);

// Lighting
scene.add(new THREE.AmbientLight(0xffffff, 0.65));
const dLight = new THREE.DirectionalLight(0xffffff, 0.8);
dLight.position.set(120, 200, 100);
scene.add(dLight);
const hLight = new THREE.HemisphereLight(0x38BDF8, 0x0A0F1D, 0.3);
scene.add(hLight);

// ====== Camera Meshes ======
const camGeo = new THREE.BoxGeometry(5, 3, 3);
const cam1Mat = new THREE.MeshStandardMaterial({ color: 0xF87171, metalness: 0.4, roughness: 0.3 });
const cam2Mat = new THREE.MeshStandardMaterial({ color: 0xFB923C, metalness: 0.4, roughness: 0.3 });
const cam1Mesh = new THREE.Mesh(camGeo, cam1Mat);
const cam2Mesh = new THREE.Mesh(camGeo, cam2Mat);
scene.add(cam1Mesh); scene.add(cam2Mesh);

// Camera Labels (Small spheres at camera tips)
const camTip1 = new THREE.Mesh(new THREE.SphereGeometry(1.2, 8, 8), new THREE.MeshBasicMaterial({ color: 0xF87171 }));
const camTip2 = new THREE.Mesh(new THREE.SphereGeometry(1.2, 8, 8), new THREE.MeshBasicMaterial({ color: 0xFB923C }));
scene.add(camTip1); scene.add(camTip2);

// Camera Mounting Poles (dashed vertical lines to ground)
