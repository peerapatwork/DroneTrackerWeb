// ELP OV2710 sensor: 1/2.7" → 5.37 × 4.04 mm, 720p resolution: 1280 × 720 px
const SENSOR_W_MM = 5.37;
const SENSOR_H_MM = 4.04;
const IMG_W_PX = 1280;
const IMG_H_PX = 720;

const LENS_PRESETS = {
    elp12:  { f_mm: 12.0,  f_px: 2860.3, fovH: 25.18, fovV: 19.13, isDemo: false, label: 'ELP 12.0 mm (720p 60fps)' },
    elp28:  { f_mm: 2.8,   f_px: 667.4,  fovH: 87.42, fovV: 71.61, isDemo: false, label: 'ELP 2.8 mm Wide (720p)' },
    elp50:  { f_mm: 50.0,  f_px: 11918,  fovH: 6.15,  fovV: 4.62,  isDemo: false, label: 'ELP 50.0 mm Tele (720p)' },
    demo:   { f_mm: 100.5, f_px: 100.5,  fovH: 25.18, fovV: 19.13, isDemo: true,  label: 'CAD Demo Scale' },
    custom: { f_mm: 12.0,  f_px: 2860.3, fovH: 25.18, fovV: 19.13, isDemo: false, label: 'Custom mm...' }
};
let activeLensKey = 'elp12';
let C = {
    baseline: 20,
    convDist: 100,
    focal: 2860.3,
    focal_mm: 12.0,
    cam1H: 0.0,
    cam2H: 0.0,
    conv1H: 0.0,
    conv2H: 0.0
};

function getFovAngles() {
    const preset = LENS_PRESETS[activeLensKey] || LENS_PRESETS.elp12;
    // FOV half-angles in radians
    const hAngle = (preset.fovH * Math.PI / 180) / 2;
    const vAngle = (preset.fovV * Math.PI / 180) / 2;
    return { h: hAngle, v: vAngle };
}

// ====== 3D FOV Convergence Screen Planes (Image Frames at R) ======
// Displays the 2D viewing screen of each camera at the convergence point (R)
function createFovScreen(colorHex) {
    // 1. Translucent Plane Fill (Subtle glass screen)
    const fillMat = new THREE.MeshBasicMaterial({
        color: colorHex, transparent: true, opacity: 0.12,
        side: THREE.DoubleSide, depthWrite: false
    });
    const fillGeo = new THREE.BufferGeometry();
    const fillMesh = new THREE.Mesh(fillGeo, fillMat);
    scene.add(fillMesh);

    // 2. Screen Border Frame
    const borderMat = new THREE.LineBasicMaterial({ color: colorHex, linewidth: 2, transparent: true, opacity: 0.85 });
    const borderGeo = new THREE.BufferGeometry();
    const borderLine = new THREE.LineLoop(borderGeo, borderMat);
    scene.add(borderLine);

    // 3. Optical Center Crosshair (+ lines)
    const crossMat = new THREE.LineDashedMaterial({ color: colorHex, dashSize: 2, gapSize: 2, transparent: true, opacity: 0.4 });
    const crossGeo = new THREE.BufferGeometry();
    const crossLine = new THREE.LineSegments(crossGeo, crossMat);
    scene.add(crossLine);

    // 4. Center Dot (Optical axis center at 0, 0)
    const centerDot = new THREE.Mesh(
        new THREE.SphereGeometry(1.0, 12, 12),
        new THREE.MeshBasicMaterial({ color: 0xFFFFFF })
    );
    scene.add(centerDot);

    // 5. Projected Target Dot on this Screen Plane
    const targetDot = new THREE.Mesh(
        new THREE.SphereGeometry(2.2, 16, 16),
        new THREE.MeshStandardMaterial({ color: colorHex, emissive: colorHex, emissiveIntensity: 0.8, roughness: 0.2 })
    );
    scene.add(targetDot);

    // 6. Dashed Offset Line (from optical center to target dot)
    const offsetMat = new THREE.LineDashedMaterial({ color: colorHex, dashSize: 1.5, gapSize: 1.5, transparent: true, opacity: 0.8 });
    const offsetGeo = new THREE.BufferGeometry();
    const offsetLine = new THREE.Line(offsetGeo, offsetMat);
    scene.add(offsetLine);

    return { fillGeo, fillMesh, borderGeo, borderLine, crossGeo, crossLine, centerDot, targetDot, offsetGeo, offsetLine };
}

