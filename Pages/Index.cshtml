function makeLabel(text, className) {
    const div = document.createElement('div');
    div.className = 'label3d ' + className;
    div.textContent = text;
    const lbl = new THREE.CSS2DObject(div);
    scene.add(lbl);
    return lbl;
}

const lblCam1 = makeLabel('📷 Cam 1', 'cam1');
const lblCam2 = makeLabel('📷 Cam 2', 'cam2');
const lblDrone = makeLabel('🛸 Drone', 'drone');
const lblConv = makeLabel('⊕ Convergence', 'conv');
const lblBaseline = makeLabel('', 'baseline');
const lblRay1Dist = makeLabel('', 'dist');    // Cam1 → Drone distance
const lblRay2Dist = makeLabel('', 'dist2');   // Cam2 → Drone distance
const lblConvDist1 = makeLabel('', 'conv-dist'); // Cam1 → Conv distance
const lblConvDist2 = makeLabel('', 'conv-dist'); // Cam2 → Conv distance
const lblAltitude = makeLabel('', 'alt');     // Altitude line
const lblScreen1Tag = makeLabel('FOV Screen 1', 'screen-tag1');
const lblScreen2Tag = makeLabel('FOV Screen 2', 'screen-tag2');
const lblScreen1Dot = makeLabel('', 'fov1-dot');
const lblScreen2Dot = makeLabel('', 'fov2-dot');

// ====== 3D Triangulation Math (with Camera Heights & Focus Heights) ======
function fwdCalc(x, y, z) {
    const hb = C.baseline / 2;
    // Horizontal (XZ ground in Three.js -> X, Y in UI)
    const a1 = Math.atan2(z - hb, x), a2 = Math.atan2(z + hb, x);
    const cv1 = Math.atan2(-hb, C.convDist), cv2 = Math.atan2(hb, C.convDist);
    const d1z = Math.tan(a1 - cv1) * C.focal;
    const d2z = Math.tan(a2 - cv2) * C.focal;

    // Vertical (Y height in Three.js -> Z in UI)
    const elevConv1 = Math.atan2(C.conv1H - C.cam1H, C.convDist);
    const elevConv2 = Math.atan2(C.conv2H - C.cam2H, C.convDist);
    const elevTgt1 = Math.atan2(y - C.cam1H, x);
    const elevTgt2 = Math.atan2(y - C.cam2H, x);
    const dy1 = Math.tan(elevTgt1 - elevConv1) * C.focal;
    const dy2 = Math.tan(elevTgt2 - elevConv2) * C.focal;

    return { d1z, d2z, dy1, dy2 };
}

function revCalc(d1z, d2z, dy1, dy2) {
    const hb = C.baseline / 2;
    const t1c = Math.atan2(-hb, C.convDist), t2c = Math.atan2(hb, C.convDist);
    const b1 = t1c + Math.atan2(d1z, C.focal), b2 = t2c + Math.atan2(d2z, C.focal);
    const sd = Math.sin(b2 - b1);
    if (Math.abs(sd) < 1e-9) return null;
    const t1 = (C.baseline * Math.cos(b2)) / sd;
    const cx = t1 * Math.cos(b1);
    const cz = hb + t1 * Math.sin(b1); // lateral in Three.js (Y in UI)

    // Vertical height reconstruction (Y in Three.js / Z in UI)
    const elevConv1 = Math.atan2(C.conv1H - C.cam1H, C.convDist);
    const elevTgt1 = elevConv1 + Math.atan2(dy1, C.focal);
    const cy1 = C.cam1H + cx * Math.tan(elevTgt1);

    return { x: cx, y: cy1, z: cz, b1, b2, db: b2 - b1 };
}

// ====== Update System ======
function update() {
    const hb = C.baseline / 2;

    // 1. Math calculations first
    const fwd = fwdCalc(dronePos.x, dronePos.y, dronePos.z);
    const rev = revCalc(fwd.d1z, fwd.d2z, fwd.dy1, fwd.dy2);

    // 2. Position cameras on mounting heights along Z-axis
    cam1Mesh.position.set(0, C.cam1H, hb);
    cam2Mesh.position.set(0, C.cam2H, -hb);
    camTip1.position.set(3, C.cam1H, hb);
    camTip2.position.set(3, C.cam2H, -hb);

    // Camera mounting poles (from ground to camera)
    pole1Geo.setFromPoints([new THREE.Vector3(0, 0, hb), cam1Mesh.position]);
    pole2Geo.setFromPoints([new THREE.Vector3(0, 0, -hb), cam2Mesh.position]);
    pole1Line.computeLineDistances();
    pole2Line.computeLineDistances();

    // Baseline Lines & Symmetric Blue Axis (towards Cam 2)
    const axisLen = Math.max(40, hb + 15);
    negZGeo.setFromPoints([
        new THREE.Vector3(0, 0, 0),
        new THREE.Vector3(0, 0, -axisLen)
    ]);
    if (axisLen > 40) {
        posZExtGeo.setFromPoints([
            new THREE.Vector3(0, 0, 40),
            new THREE.Vector3(0, 0, axisLen)
        ]);
        posZExtLine.visible = true;
    } else {
        posZExtLine.visible = false;
    }

    // Direct Baseline Line connecting Cam 2 and Cam 1
    baselineGeo.setFromPoints([cam2Mesh.position, cam1Mesh.position]);

    // Ground Baseline Line between (0, 0, -hb) and (0, 0, hb)
    groundBaselineGeo.setFromPoints([
        new THREE.Vector3(0, 0, -hb),
        new THREE.Vector3(0, 0, hb)
    ]);
    groundBaselineLine.computeLineDistances();

    // Baseline 3D Label
    const midCamY = (C.cam1H + C.cam2H) / 2;
    lblBaseline.position.set(0, midCamY + 2.5, 0);
    lblBaseline.element.textContent = `📏 Baseline = ${C.baseline.toFixed(1)} m`;

    // Position Convergence Points for Cam 1 and Cam 2
    const conv1Pos = new THREE.Vector3(C.convDist, C.conv1H, 0);
    const conv2Pos = new THREE.Vector3(C.convDist, C.conv2H, 0);
    conv1Mesh.position.copy(conv1Pos);
    conv2Mesh.position.copy(conv2Pos);

    // Convergence line from cam1 -> conv1 -> conv2 -> cam2
    convLineGeo.setFromPoints([cam1Mesh.position, conv1Pos, conv2Pos, cam2Mesh.position]);
    convLine.computeLineDistances();

    // Update FOV Screens at Convergence Points
    const s1 = updateFovScreen(screen1, cam1Mesh.position, conv1Pos);
    const s2 = updateFovScreen(screen2, cam2Mesh.position, conv2Pos);

    // Update Faint 3D FOV Beams (from cameras to convergence screens)
    updateFaintFrustum(frustum1, cam1Mesh.position, s1.pTL, s1.pTR, s1.pBR, s1.pBL);
    updateFaintFrustum(frustum2, cam2Mesh.position, s2.pTL, s2.pTR, s2.pBR, s2.pBL);

    // Drone
    droneMesh.position.copy(dronePos);
    ringMesh.position.set(dronePos.x, 0.1, dronePos.z);

    // Altitude indicator line
    altLineGeo.setFromPoints([new THREE.Vector3(dronePos.x, 0, dronePos.z), dronePos]);
    altLine.computeLineDistances();

    // Laser rays
    ray1Geo.setFromPoints([cam1Mesh.position, dronePos]);
    ray2Geo.setFromPoints([cam2Mesh.position, dronePos]);

    // ====== Update 3D Labels ======
    // Camera labels
    lblCam1.position.set(0, C.cam1H + 5, hb);
    lblCam2.position.set(0, C.cam2H + 5, -hb);

    // Drone label
    lblDrone.position.set(dronePos.x, dronePos.y + 7, dronePos.z);
    lblDrone.element.textContent = `🛸 Drone (${dronePos.x.toFixed(1)}, ${dronePos.z.toFixed(1)}, ${dronePos.y.toFixed(1)})`;

    // Convergence labels
    lblConv.position.set(C.convDist, Math.max(C.conv1H, C.conv2H) + 4, 0);
    lblConv.element.textContent = `⊕ Conv R=${C.convDist.toFixed(0)}m`;

    // Ray distance labels (midpoint of each laser line)
    const dist1 = cam1Mesh.position.distanceTo(dronePos);
    const dist2 = cam2Mesh.position.distanceTo(dronePos);
    const mid1 = new THREE.Vector3().addVectors(cam1Mesh.position, dronePos).multiplyScalar(0.5);
    const mid2 = new THREE.Vector3().addVectors(cam2Mesh.position, dronePos).multiplyScalar(0.5);
    lblRay1Dist.position.copy(mid1).add(new THREE.Vector3(0, 3, 0));
    lblRay2Dist.position.copy(mid2).add(new THREE.Vector3(0, 3, 0));
    lblRay1Dist.element.textContent = `${dist1.toFixed(1)} m`;
    lblRay2Dist.element.textContent = `${dist2.toFixed(1)} m`;

    // Screen Tag Labels (at top corners of screens)
    lblScreen1Tag.position.copy(s1.pTL).add(new THREE.Vector3(0, 3, 0));
    lblScreen1Tag.element.textContent = `📺 Cam 1 Screen (R=${C.convDist.toFixed(0)}m)`;
    lblScreen2Tag.position.copy(s2.pTR).add(new THREE.Vector3(0, 3, 0));
    lblScreen2Tag.element.textContent = `📺 Cam 2 Screen (R=${C.convDist.toFixed(0)}m)`;

    // Screen Projected Target Dot Labels with exact (d1y, dz) and (d2y, dz)
    const preset = LENS_PRESETS[activeLensKey] || LENS_PRESETS.elp12;
    if (preset.isDemo) {
        lblScreen1Dot.position.copy(s1.projPoint).add(new THREE.Vector3(0, 4.5, 0));
        lblScreen1Dot.element.textContent = `🔴 Cam 1: d1y=${fwd.d1z.toFixed(2)}, dz=${fwd.dy1.toFixed(2)} unit`;

        lblScreen2Dot.position.copy(s2.projPoint).add(new THREE.Vector3(0, 4.5, 0));
        lblScreen2Dot.element.textContent = `🟠 Cam 2: d2y=${fwd.d2z.toFixed(2)}, dz=${fwd.dy2.toFixed(2)} unit`;
    } else {
        const d1_mm = (fwd.d1z / C.focal) * C.focal_mm;
        const d2_mm = (fwd.d2z / C.focal) * C.focal_mm;
        const dz1_mm = (fwd.dy1 / C.focal) * C.focal_mm;
        const dz2_mm = (fwd.dy2 / C.focal) * C.focal_mm;
        lblScreen1Dot.position.copy(s1.projPoint).add(new THREE.Vector3(0, 4.5, 0));
        lblScreen1Dot.element.textContent = `🔴 Cam 1: d1y=${fwd.d1z.toFixed(1)} px, dz1=${fwd.dy1.toFixed(1)} px (${dz1_mm.toFixed(2)}mm)`;

        lblScreen2Dot.position.copy(s2.projPoint).add(new THREE.Vector3(0, 4.5, 0));
        lblScreen2Dot.element.textContent = `🟠 Cam 2: d2y=${fwd.d2z.toFixed(1)} px, dz2=${fwd.dy2.toFixed(1)} px (${dz2_mm.toFixed(2)}mm)`;
    }

    // Convergence line distance labels (midpoint cam→conv)
    const convDist1 = cam1Mesh.position.distanceTo(conv1Pos);
    const convDist2 = cam2Mesh.position.distanceTo(conv2Pos);
    const midC1 = new THREE.Vector3().addVectors(cam1Mesh.position, conv1Pos).multiplyScalar(0.5);
    const midC2 = new THREE.Vector3().addVectors(cam2Mesh.position, conv2Pos).multiplyScalar(0.5);
    lblConvDist1.position.copy(midC1).add(new THREE.Vector3(0, -3, 0));
    lblConvDist2.position.copy(midC2).add(new THREE.Vector3(0, -3, 0));
    lblConvDist1.element.textContent = `${convDist1.toFixed(1)} m`;
    lblConvDist2.element.textContent = `${convDist2.toFixed(1)} m`;

    // Altitude label (midpoint of altitude line)
    if (dronePos.y > 0.5) {
        lblAltitude.position.set(dronePos.x, dronePos.y / 2, dronePos.z + 3);
        lblAltitude.element.textContent = `↕ ${dronePos.y.toFixed(1)} m`;
        lblAltitude.visible = true;
    } else {
        lblAltitude.visible = false;
    }

    // Sync input fields (UI: X=forward, Y=lateral(three.z), Z=height(three.y))
    document.getElementById('inpX').value = dronePos.x.toFixed(1);
    document.getElementById('inpY').value = dronePos.z.toFixed(1);
    document.getElementById('inpZ').value = dronePos.y.toFixed(1);
    document.getElementById('inpD1Z').value = fwd.d1z.toFixed(1);
    document.getElementById('inpD2Z').value = fwd.d2z.toFixed(1);
    document.getElementById('inpDY').value = fwd.dy1.toFixed(1);
    document.getElementById('inpDY2').value = fwd.dy2.toFixed(1);

    // Viewport info row (display as X, Y_lateral, Z_height)
    const dist3D = Math.hypot(dronePos.x, dronePos.y, dronePos.z);
    document.getElementById('oPos').innerText = `(${dronePos.x.toFixed(1)}, ${dronePos.z.toFixed(1)}, ${dronePos.y.toFixed(1)})`;
    document.getElementById('oDist').innerText = dist3D.toFixed(2) + ' m';
    document.getElementById('oD1Z').innerText = fwd.d1z.toFixed(1);
    document.getElementById('oD2Z').innerText = fwd.d2z.toFixed(1);
    document.getElementById('oDY').innerText = `${fwd.dy1.toFixed(1)} / ${fwd.dy2.toFixed(1)}`;

    // Proof panel
    if (rev) {
        const err = Math.hypot(rev.x - dronePos.x, rev.y - dronePos.y, rev.z - dronePos.z);
        document.getElementById('oCalc').innerText = `(${rev.x.toFixed(2)}, ${rev.z.toFixed(2)}, ${rev.y.toFixed(2)})`;
        document.getElementById('oB1').innerText = (rev.b1 * 180 / Math.PI).toFixed(2);
        document.getElementById('oB2').innerText = (rev.b2 * 180 / Math.PI).toFixed(2);
        document.getElementById('oDB').innerText = (rev.db * 180 / Math.PI).toFixed(2);
        document.getElementById('oErr').innerText = err.toFixed(6) + ' m';
        const bd = document.getElementById('oProof');
        if (err < 0.01) { bd.className = 'proof-badge proof-ok'; bd.innerText = '✓ EXACT MATCH — 100%!'; }
        else { bd.className = 'proof-badge proof-err'; bd.innerText = `✗ Error ${err.toFixed(4)} m`; }
    }
}

// ====== View Presets & Display Toggles ======
let showLabels = true;
let showScreens = true;
let showRays = true;

function toggleLabels() {
    showLabels = !showLabels;
    const btn = document.getElementById('btnToggleLabels');
    if (showLabels) {
        btn.classList.add('active');
        btn.innerText = '🏷️ 3D Labels: ON';
        labelRenderer.domElement.style.display = 'block';
    } else {
        btn.classList.remove('active');
        btn.innerText = '🏷️ 3D Labels: OFF';
        labelRenderer.domElement.style.display = 'none';
    }
}

function setScreenVisibility(screen, visible) {
    screen.fillMesh.visible = visible;
    screen.borderLine.visible = visible;
    screen.crossLine.visible = visible;
    screen.centerDot.visible = visible;
    screen.targetDot.visible = visible;
    screen.offsetLine.visible = visible;
}

function toggleScreens() {
    showScreens = !showScreens;
    const btn = document.getElementById('btnToggleScreens');
    if (showScreens) {
        btn.classList.add('active');
        btn.innerText = '📺 FOV Screens: ON';
    } else {
        btn.classList.remove('active');
        btn.innerText = '📺 FOV Screens: OFF';
    }
    setScreenVisibility(screen1, showScreens);
    setScreenVisibility(screen2, showScreens);
    frustum1.fillMesh.visible = showScreens;
    frustum1.edgeLine.visible = showScreens;
    frustum2.fillMesh.visible = showScreens;
    frustum2.edgeLine.visible = showScreens;
    lblScreen1Tag.element.style.display = showScreens ? 'block' : 'none';
    lblScreen2Tag.element.style.display = showScreens ? 'block' : 'none';
    lblScreen1Dot.element.style.display = showScreens ? 'block' : 'none';
    lblScreen2Dot.element.style.display = showScreens ? 'block' : 'none';
}

function toggleRays() {
    showRays = !showRays;
    const btn = document.getElementById('btnToggleRays');
    if (showRays) {
        btn.classList.add('active');
        btn.innerText = '⚡ Laser Rays: ON';
    } else {
        btn.classList.remove('active');
        btn.innerText = '⚡ Laser Rays: OFF';
    }
    ray1Line.visible = showRays;
    ray2Line.visible = showRays;
    lblRay1Dist.element.style.display = showRays ? 'block' : 'none';
    lblRay2Dist.element.style.display = showRays ? 'block' : 'none';
}

function setView(type) {
    currentView = type;
    document.querySelectorAll('.view-btn').forEach(b => {
        if (b.id === 'btnTop' || b.id === 'btnSide' || b.id === 'btnIso') {
            b.classList.remove('active');
        }
    });
    if (type === 'top') {
        camera.position.set(60, 280, 0);
        controls.target.set(60, 0, 0);
        document.getElementById('btnTop').classList.add('active');
        document.getElementById('oView').innerText = 'Top View';
    } else if (type === 'side') {
        camera.position.set(60, 15, 280);
        controls.target.set(60, 0, 0);
        document.getElementById('btnSide').classList.add('active');
        document.getElementById('oView').innerText = 'Side View';
    } else {
        camera.position.set(200, 160, 200);
        controls.target.set(60, 0, 0);
        document.getElementById('btnIso').classList.add('active');
        document.getElementById('oView').innerText = 'Isometric 3D';
    }
    controls.update();
}

// ====== Config Handlers ======
function onLensChange() {
    const sel = document.getElementById('selLens').value;
    activeLensKey = sel;
    const preset = LENS_PRESETS[sel];
    if (preset && sel !== 'custom') {
        C.focal_mm = preset.f_mm;
        C.focal = preset.f_px;
        document.getElementById('inpF').value = preset.f_mm;
        if (preset.isDemo) {
            document.getElementById('lblF').innerText = preset.f_mm.toFixed(1) + ' unit';
            document.getElementById('lblFPx').innerText = '(CAD Demo Scale)';
            document.getElementById('hdrOffsetUnit').innerText = '(unit)';
        } else {
            document.getElementById('lblF').innerText = preset.f_mm.toFixed(1) + ' mm';
            document.getElementById('lblFPx').innerText = `(≈ ${Math.round(preset.f_px)} px / 720p)`;
            document.getElementById('hdrOffsetUnit').innerText = '(px)';
        }
    }
    update();
}

function onCustomFmm() {
    const val_mm = parseFloat(document.getElementById('inpF').value);
    C.focal_mm = val_mm;
    C.focal = val_mm * (IMG_W_PX / SENSOR_W_MM);
    document.getElementById('selLens').value = 'custom';
    activeLensKey = 'custom';
    LENS_PRESETS.custom.f_mm = val_mm;
    LENS_PRESETS.custom.f_px = C.focal;
    LENS_PRESETS.custom.fovH = 2 * Math.atan(SENSOR_W_MM / (2 * val_mm)) * (180 / Math.PI);
    LENS_PRESETS.custom.fovV = 2 * Math.atan(SENSOR_H_MM / (2 * val_mm)) * (180 / Math.PI);
    document.getElementById('lblF').innerText = val_mm.toFixed(1) + ' mm';
    document.getElementById('lblFPx').innerText = `(≈ ${Math.round(C.focal)} px / 720p)`;
    document.getElementById('hdrOffsetUnit').innerText = '(px)';
    update();
}

function onCfg() {
    C.baseline = parseFloat(document.getElementById('sldrB').value);
    C.convDist = parseFloat(document.getElementById('sldrR').value);
    C.cam1H = parseFloat(document.getElementById('inpCam1H').value) || 0;
    C.cam2H = parseFloat(document.getElementById('inpCam2H').value) || 0;
    C.conv1H = parseFloat(document.getElementById('inpConv1H').value) || 0;
    C.conv2H = parseFloat(document.getElementById('inpConv2H').value) || 0;
    document.getElementById('lblB').innerText = C.baseline.toFixed(1);
    document.getElementById('lblR').innerText = C.convDist;
    update();
}

function applyXYZ() {
    dronePos.x = parseFloat(document.getElementById('inpX').value);
    dronePos.z = parseFloat(document.getElementById('inpY').value);  // UI Y = three.z (lateral)
    dronePos.y = parseFloat(document.getElementById('inpZ').value);  // UI Z = three.y (height)
    update();
}

function applyReverse() {
    const d1z = parseFloat(document.getElementById('inpD1Z').value);
    const d2z = parseFloat(document.getElementById('inpD2Z').value);
    const dy1 = parseFloat(document.getElementById('inpDY').value);
    const dy2 = parseFloat(document.getElementById('inpDY2').value);
    const rev = revCalc(d1z, d2z, dy1, dy2);
    if (rev && rev.x > 0) {
        dronePos.set(rev.x, rev.y, rev.z);
        update();
    }
}

// Enter key support
['inpX','inpY','inpZ'].forEach(id => document.getElementById(id).addEventListener('keydown', e => { if(e.key==='Enter') applyXYZ(); }));
['inpD1Z','inpD2Z','inpDY','inpDY2'].forEach(id => document.getElementById(id).addEventListener('keydown', e => { if(e.key==='Enter') applyReverse(); }));

// ====== 3D Raycasting & Dragging ======
const raycaster = new THREE.Raycaster();
const mouse = new THREE.Vector2();
const groundPlane = new THREE.Plane(new THREE.Vector3(0, 1, 0), 0);  // XZ ground plane
const vertPlane = new THREE.Plane();  // vertical plane for right-click drag
const dragOffset = new THREE.Vector3();
let dragMode = null; // 'ground' or 'vertical'
let vertDragStartY = 0;

// Prevent right-click context menu on 3D canvas
renderer.domElement.addEventListener('contextmenu', (e) => e.preventDefault());

window.addEventListener('pointerdown', (e) => {
    const rect = renderer.domElement.getBoundingClientRect();
    mouse.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
    mouse.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;
    raycaster.setFromCamera(mouse, camera);
    const intersects = raycaster.intersectObject(droneMesh);
    if (intersects.length > 0) {
        isDragging = true;
        controls.enabled = false;
        if (e.button === 2) {
            // Right-click: vertical drag (height / three.y)
            dragMode = 'vertical';
            // Create a plane facing the camera that passes through the drone
            const camDir = new THREE.Vector3();
            camera.getWorldDirection(camDir);
            camDir.y = 0; camDir.normalize();
            vertPlane.setFromNormalAndCoplanarPoint(camDir, dronePos);
            vertDragStartY = e.clientY;
        } else {
            // Left-click: ground drag (XZ plane)
            dragMode = 'ground';
            const hitPoint = new THREE.Vector3();
            raycaster.ray.intersectPlane(groundPlane, hitPoint);
            dragOffset.copy(hitPoint).sub(dronePos);
        }
    }
});

window.addEventListener('pointermove', (e) => {
    if (!isDragging) return;
    const rect = renderer.domElement.getBoundingClientRect();
    mouse.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
    mouse.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;

    if (dragMode === 'ground') {
        raycaster.setFromCamera(mouse, camera);
        const pt = new THREE.Vector3();
        if (raycaster.ray.intersectPlane(groundPlane, pt)) {
            dronePos.x = pt.x - dragOffset.x;
            dronePos.z = pt.z - dragOffset.z;
            update();
        }
    } else if (dragMode === 'vertical') {
        // Map vertical mouse delta to height change
        const deltaPixels = vertDragStartY - e.clientY;
        const sensitivity = 0.5;
        dronePos.y += deltaPixels * sensitivity;
        if (dronePos.y < 0) dronePos.y = 0;
        vertDragStartY = e.clientY;
        update();
    }
});

window.addEventListener('pointerup', () => { isDragging = false; dragMode = null; controls.enabled = true; });

window.addEventListener('resize', () => {
    camera.aspect = container.clientWidth / container.clientHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(container.clientWidth, container.clientHeight);
    labelRenderer.setSize(container.clientWidth, container.clientHeight);
});

// ====== Init & Animate ======
update();
setView('top');

function animate() {
    requestAnimationFrame(animate);
    ringMesh.rotation.z += 0.005;
    controls.update();
    renderer.render(scene, camera);
    labelRenderer.render(scene, camera);
}
animate();
</script>