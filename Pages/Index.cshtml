// ====== Faint 3D FOV Beam Frustums (From Camera to Screen) ======
function createFaintFrustum(colorHex) {
    const fillMat = new THREE.MeshBasicMaterial({
        color: colorHex, transparent: true, opacity: 0.025,
        side: THREE.DoubleSide, depthWrite: false
    });
    const fillGeo = new THREE.BufferGeometry();
    const fillMesh = new THREE.Mesh(fillGeo, fillMat);
    scene.add(fillMesh);

    const edgeMat = new THREE.LineBasicMaterial({ color: colorHex, transparent: true, opacity: 0.12 });
    const edgeGeo = new THREE.BufferGeometry();
    const edgeLine = new THREE.LineSegments(edgeGeo, edgeMat);
    scene.add(edgeLine);

    return { fillGeo, fillMesh, edgeGeo, edgeLine };
}

const frustum1 = createFaintFrustum(0xF87171); // Cam 1 Faint Beam
const frustum2 = createFaintFrustum(0xFB923C); // Cam 2 Faint Beam

function updateFaintFrustum(frustum, apex, pTL, pTR, pBR, pBL) {
    // Extend 2x farther than the focus point (2.0x distance)
    const ext = 2.0;
    const fTL = new THREE.Vector3().copy(apex).addScaledVector(new THREE.Vector3().subVectors(pTL, apex), ext);
    const fTR = new THREE.Vector3().copy(apex).addScaledVector(new THREE.Vector3().subVectors(pTR, apex), ext);
    const fBR = new THREE.Vector3().copy(apex).addScaledVector(new THREE.Vector3().subVectors(pBR, apex), ext);
    const fBL = new THREE.Vector3().copy(apex).addScaledVector(new THREE.Vector3().subVectors(pBL, apex), ext);

    // 4 triangular sides extending to 2x distance
    const verts = new Float32Array([
        apex.x, apex.y, apex.z,  fTL.x, fTL.y, fTL.z,  fTR.x, fTR.y, fTR.z,
        apex.x, apex.y, apex.z,  fTR.x, fTR.y, fTR.z,  fBR.x, fBR.y, fBR.z,
        apex.x, apex.y, apex.z,  fBR.x, fBR.y, fBR.z,  fBL.x, fBL.y, fBL.z,
        apex.x, apex.y, apex.z,  fBL.x, fBL.y, fBL.z,  fTL.x, fTL.y, fTL.z
    ]);
    frustum.fillGeo.setAttribute('position', new THREE.BufferAttribute(verts, 3));
    frustum.fillGeo.computeVertexNormals();

    // 4 subtle side edge lines from camera to 2x distance + 4 far end boundary edges
    const edgeVerts = new Float32Array([
        // Side rays from apex to 2x distance
        apex.x, apex.y, apex.z,  fTL.x, fTL.y, fTL.z,
        apex.x, apex.y, apex.z,  fTR.x, fTR.y, fTR.z,
        apex.x, apex.y, apex.z,  fBR.x, fBR.y, fBR.z,
        apex.x, apex.y, apex.z,  fBL.x, fBL.y, fBL.z,
        // Far end rectangular loop at 2x distance
        fTL.x, fTL.y, fTL.z,     fTR.x, fTR.y, fTR.z,
        fTR.x, fTR.y, fTR.z,     fBR.x, fBR.y, fBR.z,
        fBR.x, fBR.y, fBR.z,     fBL.x, fBL.y, fBL.z,
        fBL.x, fBL.y, fBL.z,     fTL.x, fTL.y, fTL.z
    ]);
    frustum.edgeGeo.setAttribute('position', new THREE.BufferAttribute(edgeVerts, 3));
}

function updateFovScreen(screen, camPos, targetPoint) {
    // Normal vector pointing from camera to convergence target
    const dir = new THREE.Vector3().subVectors(targetPoint, camPos);
    const L = dir.length();
    const N = dir.clone().normalize(); // Screen Normal

    const V = new THREE.Vector3(0, 1, 0); // Up vector
    const U = new THREE.Vector3().crossVectors(V, N).normalize(); // Horizontal vector along screen plane

    // Screen dimensions based on FOV half-angles
    const fovAngles = getFovAngles();
    const halfW = L * Math.tan(fovAngles.h);
    const halfH = L * Math.tan(fovAngles.v);

    // 4 corners of the screen at targetPoint (Convergence point): TL, TR, BR, BL
    const pTL = new THREE.Vector3().copy(targetPoint).addScaledVector(U, -halfW).addScaledVector(V, halfH);
    const pTR = new THREE.Vector3().copy(targetPoint).addScaledVector(U, halfW).addScaledVector(V, halfH);
    const pBR = new THREE.Vector3().copy(targetPoint).addScaledVector(U, halfW).addScaledVector(V, -halfH);
    const pBL = new THREE.Vector3().copy(targetPoint).addScaledVector(U, -halfW).addScaledVector(V, -halfH);

    // 1. Fill Mesh (2 triangles)
    const fillVerts = new Float32Array([
        pTL.x, pTL.y, pTL.z,  pTR.x, pTR.y, pTR.z,  pBR.x, pBR.y, pBR.z,
        pTL.x, pTL.y, pTL.z,  pBR.x, pBR.y, pBR.z,  pBL.x, pBL.y, pBL.z
    ]);
    screen.fillGeo.setAttribute('position', new THREE.BufferAttribute(fillVerts, 3));
    screen.fillGeo.computeVertexNormals();

    // 2. Border Lines
    const borderVerts = new Float32Array([
        pTL.x, pTL.y, pTL.z,
        pTR.x, pTR.y, pTR.z,
        pBR.x, pBR.y, pBR.z,
        pBL.x, pBL.y, pBL.z
    ]);
    screen.borderGeo.setAttribute('position', new THREE.BufferAttribute(borderVerts, 3));

    // 3. Crosshair Lines
    const crossVerts = new Float32Array([
        targetPoint.x - U.x * halfW, targetPoint.y - U.y * halfW, targetPoint.z - U.z * halfW,
        targetPoint.x + U.x * halfW, targetPoint.y + U.y * halfW, targetPoint.z + U.z * halfW,
        targetPoint.x, targetPoint.y - halfH, targetPoint.z,
        targetPoint.x, targetPoint.y + halfH, targetPoint.z
    ]);
    screen.crossGeo.setAttribute('position', new THREE.BufferAttribute(crossVerts, 3));
    screen.crossLine.computeLineDistances();

    // 4. Optical Center Dot
    screen.centerDot.position.copy(targetPoint);

    // 5. Projected Target Dot on this Screen Plane
    // Ray from camPos through dronePos intersects screen plane at targetPoint
    const rayDir = new THREE.Vector3().subVectors(dronePos, camPos);
    const denom = rayDir.dot(N);
    let projPoint = targetPoint.clone();
    if (Math.abs(denom) > 1e-6) {
        const t = L / denom;
        projPoint = new THREE.Vector3().copy(camPos).addScaledVector(rayDir, t);
    }
    screen.targetDot.position.copy(projPoint);

    // 6. Dashed Offset Line
    screen.offsetGeo.setFromPoints([targetPoint, projPoint]);
    screen.offsetLine.computeLineDistances();

    return { projPoint, pTL, pTR, pBR, pBL };
}

